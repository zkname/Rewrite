#!name=京东本地 Cookie（实验版）
#!desc=App 捕获后手动转换。无上传，无定时。Cookie 只在本机保存；兼容性待手机实测。
#!author=zkname

[Script]
request if ${url} ~= /^https:\/\/(?:blackhole\.m\.jd\.com\/getinfo|perf\.m\.jd\.com\/app_monitor\/\w+\/getRule)(?:[?#]|$)/ then script("https://raw.githubusercontent.com/zkname/Rewrite/2ecd529005a236869e7b7f1afd6125aa0b67dee1/get_jd_wskey.js") with tag="京东App凭据捕获", requires_body=false, timeout=5
generic then script("https://raw.githubusercontent.com/zkname/Rewrite/2ecd529005a236869e7b7f1afd6125aa0b67dee1/get_jd_wskey.js", "convert") with tag="京东Cookie手动转换", timeout=45

[MITM]
hostname = blackhole.m.jd.com, perf.m.jd.com
