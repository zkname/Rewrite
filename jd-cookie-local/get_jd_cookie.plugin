#!name=京东App WSKEY（本地合并）
#!desc=分别抓取 wskey 与 pt_pin（兼容 pin），十五分钟内合并保存为 pt_pin 与 wskey，标记待核验。无上传、无转换、无定时。
#!author=zkname

[Script]
request if ${url} ~= /^https:\/\/(?:(?:blackhole\.m\.jd\.com|perf\.m\.jd\.com)(?:[\/?#]|$)|sh\.jd\.com\/j\/[A-Za-z0-9_-]+(?:[?#]|$)|mars\.jd\.com\/log\/sdk\/v2(?:[?#]|$))/ then script("https://raw.githubusercontent.com/zkname/Rewrite/16627fb01b74f8facbe7114abfaa6ebde9512257/get_jd_app_wskey.js") with tag="京东App凭据捕获", requires_body=false, timeout=5
generic then script("https://raw.githubusercontent.com/zkname/Rewrite/16627fb01b74f8facbe7114abfaa6ebde9512257/get_jd_app_wskey.js", "status") with tag="京东App抓取状态", timeout=5
generic then script("https://raw.githubusercontent.com/zkname/Rewrite/16627fb01b74f8facbe7114abfaa6ebde9512257/get_jd_app_wskey.js", "clear") with tag="京东App清除暂存", timeout=5

[MITM]
hostname = blackhole.m.jd.com, perf.m.jd.com, sh.jd.com, mars.jd.com
