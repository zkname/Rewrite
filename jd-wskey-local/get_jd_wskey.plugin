#!name=京东App WSKEY（本地抓取）
#!desc=抓取、状态和清除均在本机完成，无上传、无转换、无定时。需 App 实测。
#!author=zkname

[Script]
request if ${url} ~= /^https:\/\/(?:(?:blackhole\.m\.jd\.com|perf\.m\.jd\.com)(?:[\/?#]|$)|sh\.jd\.com\/j\/[A-Za-z0-9_-]+(?:[?#]|$))/ then script("https://raw.githubusercontent.com/zkname/Rewrite/32f68e6cd3ab72d9132b5f5ad15b9d05731e18fb/get_jd_app_wskey.js") with tag="京东App凭据捕获", requires_body=false, timeout=5
generic then script("https://raw.githubusercontent.com/zkname/Rewrite/32f68e6cd3ab72d9132b5f5ad15b9d05731e18fb/get_jd_app_wskey.js", "status") with tag="京东App抓取状态", timeout=5
generic then script("https://raw.githubusercontent.com/zkname/Rewrite/32f68e6cd3ab72d9132b5f5ad15b9d05731e18fb/get_jd_app_wskey.js", "clear") with tag="京东App清除暂存", timeout=5

[MITM]
hostname = blackhole.m.jd.com, perf.m.jd.com, sh.jd.com
